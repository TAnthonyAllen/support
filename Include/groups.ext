    isLiteral
    isLocal
    isMacro
    isPercent
    isPointer
    isShortcut
    isSingleton
    isToggle
    isUnary
    isVirtual
    isWindow
    isXP
    mergeOn
    negate
    recursive
    reversePrint
    tokened
    hasNewParse
    hasTraits } flags;

    GroupBody();
    GroupBody(String s);
	alias
        bitmap              gMap
        buffer              gBuffer
        character           gCharacter
        characterSet        gCharacterSet
        count				gCount
        group               gGroup
        item				gItem
        jitEmitter          gJitEmitter
        method              gMethod
        number				gNumber
        object              gObject
        operat              gOp
        pointer				gPointer
        regex               gRegex
